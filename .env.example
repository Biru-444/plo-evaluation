# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# FastAPI Settings
DEBUG=True
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (frontend URLs). Falls back to
# http://localhost:3000,http://localhost:8080 if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT signing secret - generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# Gemini API key (Google AI Studio) - ใช้โดย POST /courses/import-from-mco3 (นำเข้าข้อมูลวิชาจาก
# มคอ.3 ด้วย AI) หาได้จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here